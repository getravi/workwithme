{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "recording-options", "recording-pill", "trim-editor", "region-select-recording"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "opener:allow-open-url",
    "opener:allow-open-path",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-copy-file",
    "fs:allow-remove"
  ]
}
